{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "es2023",
		"lib": ["ES2023", "DOM"],
		"module": "esnext",
		"types": ["vite/client"],
		"allowArbitraryExtensions": true,
		"skipLibCheck": true,
		/* Two independent reasons, which a merge kept apart: `package.json` is statically
		   imported as the one source of the app version (M5.3) — the file is inlined at
		   build time, so the number cannot drift from the one the bundle is stamped with —
		   and the vendored theme document is imported as data (`theme/themes.ts`) so the
		   built-in themes are read out of it rather than re-typed. */
		"resolveJsonModule": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",

		/* Paths: `@/*` → `src/*`, mirrored by the Vite alias in vite.config.ts */
		"strict": true,
		"paths": {
			"@/*": ["./src/*"]
		},

		/* Linting */
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src"],
	/* Tests and their DOM preload are tsconfig.test.json's: they need @types/bun, which
	   app code must not see. */
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}

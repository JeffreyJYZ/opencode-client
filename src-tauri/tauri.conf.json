{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "opencode client",
	"version": "../package.json",
	"identifier": "com.jyz.opencode.client",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "bun run dev --port 1420 --strictPort",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://github.com/JeffreyJYZ/opencode-client/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2QjgxNzhEMTZDQjU1RTEKUldUaFZjc1dqUmU0UnZPQnR0WVB5OU5rd2x3SUV6MEdPaHdYejZDen56ZGVCSlA1QXY0NGFGMFoK"
		}
	}
}

{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "opencode client",
	"version": "0.1.0",
	"identifier": "land.jyz.opencode",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "bun run dev --port 5173 --strictPort",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}

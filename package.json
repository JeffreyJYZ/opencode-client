		"shiki": "^4.5.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@biomejs/biome": "^2.5.15",
		"@happy-dom/global-registrator": "^21.0.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tauri-apps/cli": "^2.12.3",
